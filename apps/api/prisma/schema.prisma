generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                           @id @default(uuid()) @db.Uuid
  email                  String                           @unique
  passwordHash           String?
  emailVerifiedAt        DateTime?                        @db.Timestamptz(3)
  createdAt              DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                         @updatedAt @db.Timestamptz(3)
  emailVerificationToken EmailVerificationToken?
  passwordResetToken     PasswordResetToken?
  authSessions           AuthSession[]
  googleIdentity         GoogleIdentity?
  extensionLinkRequests  ExtensionLinkRequest[]
  extensionCredentials   ExtensionObservationCredential[]
}

model GoogleIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  subject   String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  accessTokenHash String         @unique @db.Char(64)
  accessExpiresAt DateTime       @db.Timestamptz(3)
  expiresAt       DateTime       @db.Timestamptz(3)
  revokedAt       DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  tokenHash String      @unique @db.Char(64)
  rotatedAt DateTime?   @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  sentAt     DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  sentAt     DateTime  @default(now()) @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum GroupAvailabilityStatus {
  AVAILABLE
  FULL
  UNKNOWN
}

enum GroupStateEventKind {
  DISCOVERED
  STATUS_CHANGED
}

model Course {
  id             String   @id @default(uuid()) @db.Uuid
  btuCourseId    String   @unique @db.VarChar(255)
  name           String?  @db.VarChar(500)
  lastObservedAt DateTime @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  groups         Group[]
}

model Group {
  id              String                  @id @default(uuid()) @db.Uuid
  courseId        String                  @db.Uuid
  btuGroupId      String                  @db.VarChar(255)
  name            String?                 @db.VarChar(500)
  capacity        Int?
  status          GroupAvailabilityStatus
  chooseUrl       String?                 @db.VarChar(2048)
  firstObservedAt DateTime                @db.Timestamptz(3)
  lastObservedAt  DateTime                @db.Timestamptz(3)
  course          Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stateChanges    GroupStateChange[]

  @@unique([courseId, btuGroupId])
}

model GroupStateChange {
  id             String                   @id @default(uuid()) @db.Uuid
  groupId        String                   @db.Uuid
  kind           GroupStateEventKind
  previousStatus GroupAvailabilityStatus?
  status         GroupAvailabilityStatus
  observedAt     DateTime                 @db.Timestamptz(3)
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  group          Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, observedAt])
  @@index([observedAt])
}

model ExtensionLinkRequest {
  id               String    @id @default(uuid()) @db.Uuid
  installationId   String    @db.Uuid
  extensionId      String    @db.VarChar(32)
  challengeHash    String    @db.Char(64)
  expiresAt        DateTime  @db.Timestamptz(3)
  approvedByUserId String?   @db.Uuid
  approvedAt       DateTime? @db.Timestamptz(3)
  consumedAt       DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  approvedBy       User?     @relation(fields: [approvedByUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([approvedByUserId])
}

model ExtensionObservationCredential {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  installationId String    @db.Uuid
  extensionId    String    @db.VarChar(32)
  tokenHash      String    @unique @db.Char(64)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  lastUsedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([installationId])
  @@index([expiresAt])
}
