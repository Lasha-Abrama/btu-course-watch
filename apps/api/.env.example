NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://btu_course_watch:btu_course_watch@localhost:5433/btu_course_watch?schema=public
# Exact frontend origin: trusted for CORS/CSRF and used for verification/reset email links.
CORS_ORIGIN=http://localhost:3000
# For a same-site frontend/API use lax; cross-site production deployments need none over HTTPS.
COOKIE_SAME_SITE=lax
API_PUBLIC_URL=http://localhost:3001
# Configure a Google Cloud OAuth 2.0 Web application client. Replace placeholders locally.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
GOOGLE_POST_AUTH_REDIRECT_URL=http://localhost:3000/
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=no-reply@btu.edu.ge
# Set both for an SMTP server that requires authentication. Never commit real credentials.
# SMTP_USER=
# SMTP_PASSWORD=
