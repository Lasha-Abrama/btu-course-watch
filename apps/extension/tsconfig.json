{
  "compilerOptions": {
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["chrome", "node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
